PUBLIC_URL=http://localhost:4111
RECALL_API_KEY=
RECALL_REGION=us-west-2
RECALL_WEBHOOK_SECRET=
# Signing secret of the Recall dashboard webhook endpoint (/recall/webhook)
RECALL_WEBHOOK_VERIFICATION_SECRET=
# Shared with the hub bookings snippet (X-Hook-Secret on /bookings)
BOOKINGS_SECRET=
# Saved calls: file:./data/calls.db locally, file:/data/calls.db on Coolify, or libsql://... for Turso
DATABASE_URL=file:./data/calls.db
DATABASE_AUTH_TOKEN=
ANTHROPIC_API_KEY=
SELLERS=Tylan Miller <tylan@otakusolutions.io> admin, Ric Forbes <ricforbes@otakusolutions.io>
FLUENTCRM_AUTH=
# Optional; defaults to https://hub.otakusolutions.io
FLUENTCRM_URL=
# Optional: DM the live-screen link in Slack (Perry's bot token; seller email=Slack member id, comma separated)
SLACK_BOT_TOKEN=
SLACK_USERS=
# Optional; unset lets each seller name their bot
BOT_NAME=
# Optional; signs seller sessions. Defaults to a key derived from RECALL_API_KEY
SESSION_SECRET=
# Optional; defaults to anthropic/claude-haiku-5-5
SALES_CALL_MODEL=
# Optional server settings
PORT=4111
HOST=
WEB_DIST=
# Tests: answer model calls from AIMock (fixtures/) instead of Anthropic
USE_AIMOCK=
AIMOCK_URL=
AIMOCK_MODEL=
