{
  "name": "meeting-agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Meeting agents for Otaku Solutions on Mastra: Recall.ai bots that join Zoom and Google Meet calls. First agent: the sales call co-pilot.",
  "scripts": {
    "dev": "npm run build:web && mastra dev",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:web && mastra build",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "node .mastra/output/index.mjs",
    "typecheck": "tsc && tsc -p web",
    "test": "start-server-and-test aimock http-get://127.0.0.1:4010/health test:unit",
    "demo": "npm run build:web && tsx scripts/demo.ts",
    "test:unit": "USE_AIMOCK=true vitest run",
    "aimock": "llmock -p 4010 -h 127.0.0.1 -f ./fixtures --validate-on-load --strict"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.106",
    "@mastra/core": "^1.81.0",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@copilotkit/aimock": "^1.47.0",
    "@hono/node-server": "^1.19.18",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "mastra": "^1.37.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "start-server-and-test": "^3.0.13",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
